# ── IA (Claude) ── https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# Opcional: modelo de la IA (por defecto claude-haiku-5-5, el más económico)
# CLAUDE_MODEL=claude-opus-5-5

# ── Cuentas de usuario (Supabase) ── Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cobros (Mercado Pago) ── Tus integraciones → Credenciales de producción
MP_ACCESS_TOKEN=
# Webhooks → "Clave secreta" (para verificar las notificaciones)
MP_WEBHOOK_SECRET=

# ── Plan ──
PLAN_NAME=Impulsa Studio — Plan mensual
PLAN_PRICE=25000
PLAN_CURRENCY=ARS
AI_MONTHLY_LIMIT=200
# Prueba gratis desde el registro (0 = sin prueba) y créditos de IA durante la prueba
TRIAL_DAYS=3
TRIAL_AI_LIMIT=20

# Mails con acceso al panel /admin (separados por coma)
ADMIN_EMAILS=
# Dirección pública de la web, ej. https://impulsa-studiodigital.vercel.app
NEXT_PUBLIC_SITE_URL=

# Soporte: se muestra en el botón «❓ Ayuda» (WhatsApp con código de país, ej. 5491123456789)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Voces naturales para la voz en off (ElevenLabs) ── elevenlabs.io → Developers → API Keys
# Sin esto se usa la voz básica gratuita (robótica).
ELEVENLABS_API_KEY=
# Opcional: voz por defecto (Voice ID) y modelo
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
